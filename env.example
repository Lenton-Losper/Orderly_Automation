# LLL Farming WhatsApp Bot - Environment Variables
# Copy this file to .env and update the values for your environment

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
NODE_ENV=production
DOCKER_ENV=true

# =============================================================================
# SERVICE URLS (Auto-configured in Docker, override for local development)
# =============================================================================
# Rasa Services
RASA_URL=http://rasa:5005
RASA_ACTION_SERVER_URL=http://rasa-actions:5055
RASA_BASE_URL=http://rasa:5005
RASA_TOKEN=

# Database Services
REDIS_URL=redis://redis:6379
MONGODB_URL=mongodb://mongodb:27017

# Backend Services
BACKEND_URL=http://backend:3000
BOT_TRAINING_URL=http://bot-training:3001

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
PORT=3000
API_PORT=3001
WEBSOCKET_PORT=8080
BASE_PORT=3000
WEBSOCKET_BASE_PORT=8080

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# =============================================================================
# TENANT CONFIGURATION
# =============================================================================
TENANT_ID=default
TENANTS_DIR=/app/tenants
LOGS_DIR=/app/logs
MODELS_DIR=/app/rasa-models

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# WHATSAPP CONFIGURATION
# =============================================================================
# Phone number for the WhatsApp bot
WHATSAPP_PHONE=264813141453
OWNER_NUMBER=264813141453

# WhatsApp session and authentication settings
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_AUTH_TIMEOUT=60000
WHATSAPP_MAX_RETRIES=5
WHATSAPP_QR_MAX_RETRIES=5
WHATSAPP_HEADLESS=true

# Debug mode for WhatsApp
DEBUG=whatsapp-web.js:*

# =============================================================================
# DEVELOPMENT OVERRIDES (for local development)
# =============================================================================
# Uncomment these for local development without Docker
# RASA_URL=http://localhost:5005
# RASA_ACTION_SERVER_URL=http://localhost:5055
# REDIS_URL=redis://localhost:6379
# MONGODB_URL=mongodb://localhost:27017
# FIREBASE_CREDENTIALS_PATH=./lllfarming-firebase-adminsdk-fbsvc-c9ce466038.json
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT_SECRET=your-jwt-secret-here
# ENCRYPTION_KEY=your-encryption-key-here

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================
# SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=
# MIXPANEL_TOKEN=



