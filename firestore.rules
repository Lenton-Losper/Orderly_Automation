rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------
    // Helper Functions
    // ------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isServiceAccount() {
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.email.matches('.*@.*\\.iam\\.gserviceaccount\\.com$');
    }

    function isValidUsername(username) {
      return username.matches('^[a-zA-Z0-9_]{3,30}$');
    }

    function isValidPhoneNumber(phone) {
      return phone.matches('^\\+?[1-9]\\d{1,14}$');
    }

    // Signed-in user's mapped phone must match vendor phoneId
    function isPhoneOwner(phoneId) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/uid_to_phone_mapping/$(request.auth.uid))
             && get(/databases/$(database)/documents/uid_to_phone_mapping/$(request.auth.uid)).data.phoneId == phoneId;
    }

    // Check if user owns a tenant
    function isTenantOwner(tenantId) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/tenants/$(tenantId))
             && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
    }

    // NEW: Check if user is a member of a tenant (for new signup system)
    function isTenantMember(tenantId) {
      return isSignedIn() && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    // NEW: Check if user is admin of tenant
    function isTenantAdmin(tenantId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // NEW: Check if user has specific role in tenant
    function hasTenantRole(tenantId, role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == role;
    }

    // NEW: Check if user has permission in tenant
    function hasTenantPermission(tenantId, permission) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.permissions.hasAny([permission]);
    }

    // ------------------------
    // UID → Phone Mapping
    // ------------------------
    match /uid_to_phone_mapping/{uid} {
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['phoneId', 'email'])
                    && request.resource.data.phoneId is string;
      allow read, update, delete: if isOwner(uid) || isAdmin();
    }

    // ------------------------
    // NEW: Users Collection (for new signup system)
    // ------------------------
    match /users/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['email', 'businessName']);
      allow read, update, delete: if isOwner(userId) || isAdmin();
    }

    // ------------------------
    // NEW: Tenants Collection (for new tenant system)
    // ------------------------
    match /tenants/{tenantId} {
      // Allow creation by authenticated users (for signup)
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Allow read by tenant owner or members
      allow read: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId));
      // Allow update/delete by tenant owner or admin
      allow update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isAdmin()) || isServiceAccount();

      // Bot Session for WhatsApp QR
      match /botSession/{sessionId} {
        allow read: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId));
        allow create, update: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId)) || isServiceAccount();
        allow delete: if isAdmin();
      }

      // Members subcollection - only admins can manage members
      match /members/{userId} {
        allow read: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId));
        allow create, update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isTenantAdmin(tenantId)) || isServiceAccount();
      }

      // Tenant Products
      match /products/{productId} {
        allow read: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId));
        allow create, update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId)) || isServiceAccount();
      }

      // Tenant Categories
      match /categories/{categoryId} {
        allow read: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId));
        allow create, update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId)) || isServiceAccount();
      }

      // Tenant Customers
      match /customers/{customerId} {
        allow create: if true; // bot can create
        allow read, update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId)) || isServiceAccount();
      }

      // Tenant Orders
      match /orders/{orderId} {
        allow create: if true; // bot can create
        allow read, update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isTenantMember(tenantId)) || isServiceAccount();
      }
    }

    // ------------------------
    // Global Collections
    // ------------------------
    match /orders/{orderId} {
      allow create: if true; // bot can create
      allow read, update, delete: if isSignedIn();
    }

    match /customers/{customerId} {
      allow create: if true; // bot can create
      allow read, update, delete: if isSignedIn();
    }

    match /global_usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
                     && isValidUsername(username)
                     && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /global_phone_numbers/{phoneNumber} {
      allow read: if true;
      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /username_email_mapping/{username} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidUsername(username);
      allow delete: if isSignedIn();
    }

    match /whatsapp_business_mapping/{mappingId} {
      allow read, write: if true;   // bot can use this
      allow delete: if isAdmin();
    }

    // ------------------------
    // Vendor Scoped Data (Legacy Support)
    // ------------------------
    match /vendors/{phoneId} {
      // Vendor root
      allow create: if isSignedIn() || isServiceAccount();
      allow read: if true;
      allow write: if isSignedIn() || isServiceAccount();
      allow delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isAdmin();

      // Vendor Profile
      match /profile/{profileId} {
        allow create: if ((isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount())
                       && request.resource.data.keys().hasAll(['username','name','email','phone']);
        allow read: if true;
        allow write: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        allow delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isAdmin();
      }

      // Username reservations
      match /usernames/{usernameId} {
        allow create: if ((isSignedIn() && isValidUsername(usernameId) && isPhoneOwner(phoneId)) || isServiceAccount());
        allow read: if true;
        allow write: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        allow delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isAdmin();
      }

      // Phones
      match /phones/{phoneDocId} {
        allow create: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        allow read: if true;
        allow write: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        allow delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isAdmin();
      }

      // ------------------------
      // 🔹 Multi-Tenant Isolation (Legacy)
      // ------------------------
      match /tenants/{tenantId} {
        // Tenant root document permissions
        allow read: if true; // Allow reading tenant info
        allow create, write: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        
        // Tenant Products
        match /products/{productId} {
          allow read: if true; // Public read access
          allow create: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
          allow update, delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        }

        // Tenant Customers
        match /customers/{customerId} {
          allow create: if true; // bot can create
          allow read, update, delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        }

        // Tenant Orders
        match /orders/{orderId} {
          allow create: if true; // bot can create
          allow read, update, delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        }
      }

      // ------------------------
      // 🔹 Backward Compatibility (non-tenant paths)
      // ------------------------
      match /customers/{customerId} {
        allow create: if true;
        allow read, update, delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
      }

      match /orders/{orderId} {
        allow create: if true;
        allow read, update: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
        allow delete: if (isSignedIn() && isPhoneOwner(phoneId)) || isServiceAccount();
      }

      // Billing
      match /billing/{document=**} {
        allow read, write: if isServiceAccount() || (isSignedIn() && isPhoneOwner(phoneId));
      }
    }

    // ------------------------
    // Collection Group Reads
    // ------------------------
    match /{path=**}/usernames/{usernameId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/phones/{phoneNumber} {
      allow read: if isSignedIn();
    }

    // Collection group query for products across all paths
    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // ------------------------
    // Admin Section
    // ------------------------
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
